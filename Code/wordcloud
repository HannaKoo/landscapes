from wordcloud import WordCloud
import matplotlib.pyplot as plt

def show_word_cloud(text, compound_words=[]):
    # Replace spaces in compound words with underscores
    for phrase in compound_words:
        text = text.replace(phrase, phrase.replace(" ", "_"))

    
    # Generate the word cloud
    cloud = WordCloud(width=1000, height=1000, background_color='white',stopwords=set(), min_font_size=10, max_words=200)
    cloud = cloud.generate(text)
    
    # Convert the cloud to an array to manipulate it
    cloud_array = cloud.to_array()
    
    # Display the word cloud
    plt.figure(figsize=(10, 10))
    plt.imshow(cloud_array, interpolation="bilinear")
    plt.axis('off')
    
    # Save and then display the image, replacing underscores with spaces
    # Save the word cloud image with high resolution
    plt.savefig("kielimaisemat_sanapilvi.png", dpi=600, bbox_inches='tight')
    # plt.savefig(filename=plt.savefig(), dpi=1200, bbox_inches='tight')
    plt.show()

